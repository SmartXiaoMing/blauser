<?xml version="1.0" encoding="utf-8"?>
<!--
  全局设置面板：页面宽度 / UserAgent / 屏幕方向 / 语言。

  刻意不设底色 —— 这是 AlertDialog 的自定义 view，面板背景由对话框主题提供，
  自己再糊一层不透明色会盖掉圆角，还会多画一层（lint 的 Overdraw）。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <!-- ===== 页面宽度 ===== -->
        <TextView
            style="@style/SettingsLabel"
            android:text="@string/settings_width" />

        <Spinner
            android:id="@+id/spWidth"
            android:layout_width="match_parent"
            android:layout_height="44dp" />

        <TextView
            style="@style/SettingsHint"
            android:text="@string/settings_width_hint" />

        <!-- ===== UserAgent ===== -->
        <TextView
            style="@style/SettingsLabel"
            android:text="@string/settings_ua" />

        <Spinner
            android:id="@+id/spUa"
            android:layout_width="match_parent"
            android:layout_height="44dp" />

        <EditText
            android:id="@+id/etUaCustom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minHeight="44dp"
            android:background="@drawable/bg_url_bar"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textSize="12sp"
            android:inputType="text"
            android:importantForAutofill="no"
            android:hint="@string/settings_ua_custom_hint"
            android:visibility="gone" />

        <!-- ===== 屏幕方向 ===== -->
        <TextView
            style="@style/SettingsLabel"
            android:text="@string/settings_orientation" />

        <Spinner
            android:id="@+id/spOrientation"
            android:layout_width="match_parent"
            android:layout_height="44dp" />

        <!-- ===== 语言 ===== -->
        <TextView
            style="@style/SettingsLabel"
            android:text="@string/settings_language" />

        <EditText
            android:id="@+id/etLanguage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:background="@drawable/bg_url_bar"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:singleLine="true"
            android:textSize="13sp"
            android:inputType="text"
            android:importantForAutofill="no"
            android:hint="@string/settings_language_hint" />

        <TextView
            style="@style/SettingsHint"
            android:layout_marginTop="16dp"
            android:text="@string/settings_global_hint" />

    </LinearLayout>

</ScrollView>
