<?xml version="1.0" encoding="utf-8"?>
<!--
  本站设置：按域名覆盖全局配置。未覆盖的项跟随全局。

  同 dialog_settings.xml，底色交给 AlertDialog 主题，自己不设。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <!-- 一键预设 -->
        <TextView
            style="@style/SettingsLabel"
            android:layout_marginTop="6dp"
            android:text="@string/site_preset" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnPresetDesktop"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/site_preset_desktop"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/on_brand"
                android:background="@drawable/bg_tab_active" />

            <TextView
                android:id="@+id/btnPresetMobile"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:gravity="center"
                android:text="@string/site_preset_mobile"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_tab_inactive" />
        </LinearLayout>

        <TextView
            style="@style/SettingsHint"
            android:text="@string/site_preset_hint" />

        <!-- 屏幕方向 -->
        <TextView
            style="@style/SettingsLabel"
            android:text="@string/settings_orientation" />

        <Spinner
            android:id="@+id/spSiteOrientation"
            android:layout_width="match_parent"
            android:layout_height="44dp" />

        <!-- 页面宽度 -->
        <TextView
            style="@style/SettingsLabel"
            android:text="@string/settings_width" />

        <Spinner
            android:id="@+id/spSiteWidth"
            android:layout_width="match_parent"
            android:layout_height="44dp" />

        <!-- 自定义分辨率：下拉选了「自定义…」才出现 -->
        <LinearLayout
            android:id="@+id/customSizeRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/etCustomWidth"
                android:text="@string/custom_width"
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />

            <EditText
                android:id="@+id/etCustomWidth"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_url_bar"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textSize="13sp"
                android:inputType="number"
                android:importantForAutofill="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:labelFor="@id/etCustomHeight"
                android:text="@string/custom_height"
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />

            <EditText
                android:id="@+id/etCustomHeight"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_url_bar"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textSize="13sp"
                android:inputType="number"
                android:importantForAutofill="no" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCustomSizeHint"
            style="@style/SettingsHint"
            android:text="@string/custom_size_hint"
            android:visibility="gone" />

        <!-- UserAgent -->
        <TextView
            style="@style/SettingsLabel"
            android:text="@string/settings_ua" />

        <Spinner
            android:id="@+id/spSiteUa"
            android:layout_width="match_parent"
            android:layout_height="44dp" />

        <!-- 语言 -->
        <TextView
            style="@style/SettingsLabel"
            android:text="@string/settings_language" />

        <EditText
            android:id="@+id/etSiteLanguage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:background="@drawable/bg_url_bar"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:singleLine="true"
            android:textSize="13sp"
            android:inputType="text"
            android:importantForAutofill="no"
            android:hint="@string/settings_language_hint" />

        <TextView
            style="@style/SettingsHint"
            android:text="@string/site_language_hint" />

        <!-- ===== 缩放（按网站，没有「跟随全局」）===== -->
        <CheckBox
            android:id="@+id/cbSiteZoom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/site_zoom"
            android:textSize="14sp" />

        <TextView
            style="@style/SettingsHint"
            android:text="@string/site_zoom_hint" />

        <TextView
            style="@style/SettingsHint"
            android:layout_marginTop="14dp"
            android:text="@string/site_inherit_hint" />

        <!--
          证书例外：只有真的接受过这个域名的无效证书时才出现。
          没有例外时整行不显示 —— 摆一行「暂无」只是占地方。
        -->
        <LinearLayout
            android:id="@+id/sslExceptionRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSiteSslException"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    style="@style/SettingsHint"
                    android:text="@string/site_ssl_exception_hint" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnClearSslException"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="10dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:gravity="center"
                android:text="@string/action_clear"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_tab_inactive" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
